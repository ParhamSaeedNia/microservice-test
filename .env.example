# Host processes. Copy to .env. Compose overrides hostnames for the apps profile.
# Local passwords are for the Docker sandbox only.

POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market

CATALOG_PORT=3001
CATALOG_DATABASE_URL=postgres://market:market@localhost:5432/catalog

ORDERS_PORT=3002
ORDERS_DATABASE_URL=postgres://market:market@localhost:5432/orders
CATALOG_BASE_URL=http://localhost:3001

INVENTORY_PORT=3003
INVENTORY_DATABASE_URL=postgres://market:market@localhost:5432/inventory
KAFKA_BROKERS=localhost:9094

NOTIFICATIONS_PORT=3004
NOTIFICATIONS_DATABASE_URL=postgres://market:market@localhost:5432/notifications
RABBITMQ_URL=amqp://market:market@localhost:5672

DISPATCHER_PORT=3005

LOG_DIR=../../logs
GRAFANA_ADMIN_PASSWORD=admin
